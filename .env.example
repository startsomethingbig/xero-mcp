# Xero API configuration (all required)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
# Long random value; keys the preview->confirm tokens (HMAC).
XERO_CONFIRMATION_SECRET=

# Optional; shown with their defaults. Leave unset rather than blank-override.
# XERO_CONFIRMATION_TTL_SECONDS=600
# PORT=3000

# HTTP mode only
# Required in http mode; at least 32 characters. Clients send it as Authorization: Bearer <token>.
MCP_AUTH_TOKEN=
# MCP_BIND_HOST=127.0.0.1
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# MCP_MAX_BODY_BYTES=1048576
